PROJECT_NAME="Bal Vote API"
SECRET_KEY="replace-with-a-long-random-secret-before-production"
DATABASE_URL="sqlite:///./bal_vote.db"
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:5174"]'
ACCESS_TOKEN_EXPIRE_MINUTES=60
FIRST_SUPERUSER="admin"
FIRST_SUPERUSER_PASSWORD="set-a-strong-password-before-initializing"

# Required in production for durable image storage.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional: local files are stored here when CLOUDINARY_URL is absent.
MEDIA_ROOT=media
